# Copy to .env and edit. Overrides config/config.php.
# Naming rule: dotted config path, upper-cased, TBW_ prefix.

TBW_DB_HOST=127.0.0.1
TBW_DB_PORT=3306
TBW_DB_NAME=tbw_forecast
TBW_DB_USER=root
TBW_DB_PASS=

TBW_API_URL=https://apps.daesang.net/api/mqtt/latest.php
TBW_API_TOKEN=apps-mqtt-static-7f3c9e2a1b8d4f60

# Set to false only on a trusted network without a CA bundle.
TBW_API_VERIFY_TLS=true

TBW_FORECAST_SERVICE_URL=http://127.0.0.1:8008
